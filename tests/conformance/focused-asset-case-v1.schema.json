{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sagikazarmark/excalidraw-render.orig/tests/conformance/focused-asset-case-v1.schema.json",
  "title": "Excalidraw focused asset-bearing scene case v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval",
    "assets",
    "case_id",
    "comparison",
    "compatibility_revision",
    "coverage",
    "crops",
    "determinism",
    "exceptions",
    "feature_tags",
    "layer",
    "license",
    "originating_issue",
    "provenance",
    "purpose",
    "reference",
    "sanitization",
    "scene",
    "schema",
    "semantic_expectations",
    "variants"
  ],
  "properties": {
    "approval": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approved_at",
            "approved_by",
            "approval_subject_sha256",
            "approval_url"
          ],
          "properties": {
            "approved_at": {
              "type": "string",
              "format": "date"
            },
            "approved_by": {
              "type": "string",
              "minLength": 1
            },
            "approval_subject_sha256": {
              "$ref": "#/$defs/prefixedDigest"
            },
            "approval_url": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      ]
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file_id",
          "media_type",
          "byte_length",
          "sha256"
        ],
        "properties": {
          "file_id": {
            "type": "string",
            "minLength": 1
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "byte_length": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparator_profiles",
        "viewer_profiles"
      ],
      "properties": {
        "comparator_profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/profileIdentity"
          }
        },
        "viewer_profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/profileIdentity"
          }
        }
      }
    },
    "compatibility_revision": {
      "type": "integer",
      "minimum": 1
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/coverage"
      }
    },
    "crops": {
      "type": "array",
      "maxItems": 0
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "animation_offset_microseconds",
        "fresh_process_runs"
      ],
      "properties": {
        "animation_offset_microseconds": {
          "const": 0
        },
        "fresh_process_runs": {
          "const": 2
        }
      }
    },
    "exceptions": {
      "type": "array",
      "maxItems": 0
    },
    "feature_tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "layer": {
      "enum": [
        "exact-vector",
        "focused",
        "representative",
        "adversarial",
        "regression"
      ]
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "copyright",
        "expression"
      ],
      "properties": {
        "copyright": {
          "type": "string"
        },
        "expression": {
          "const": "MIT OR Apache-2.0"
        }
      }
    },
    "originating_issue": {
      "type": "string",
      "format": "uri"
    },
    "provenance": {
      "$ref": "#/$defs/file"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_manifest",
        "profile",
        "scene_surface"
      ],
      "properties": {
        "asset_manifest": {
          "$ref": "#/$defs/identity"
        },
        "profile": {
          "$ref": "#/$defs/identity"
        },
        "scene_surface": {
          "$ref": "#/$defs/identity"
        }
      }
    },
    "sanitization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "performed",
        "reason"
      ],
      "properties": {
        "performed": {
          "const": false
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "scene": {
      "$ref": "#/$defs/file"
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "id",
        "path"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/prefixedDigest"
        },
        "id": {
          "const": "excalidraw-render/conformance-case/focused-asset-scene/v1"
        },
        "path": {
          "type": "string"
        }
      }
    },
    "semantic_expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "element_counts",
        "embedded_scene",
        "images",
        "links",
        "masks",
        "selectable_text"
      ],
      "properties": {
        "element_counts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          },
          "propertyNames": {
            "type": "string",
            "minLength": 1
          }
        },
        "embedded_scene": {
          "type": "boolean"
        },
        "images": {
          "type": "integer",
          "minimum": 0
        },
        "links": {
          "type": "integer",
          "minimum": 0
        },
        "masks": {
          "type": "integer",
          "minimum": 0
        },
        "selectable_text": {
          "type": "boolean"
        }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/variant"
      }
    }
  },
  "$defs": {
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "role"
      ],
      "properties": {
        "identity": {
          "type": "string"
        },
        "role": {
          "const": "primary"
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prefixedDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "file": {
      "type": "object",
      "required": [
        "byte_length",
        "path",
        "sha256"
      ],
      "properties": {
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "layout": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "pixel_format": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "path"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/prefixedDigest"
        },
        "path": {
          "type": "string"
        }
      }
    },
    "profileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "id",
        "scope"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/prefixedDigest"
        },
        "id": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        }
      }
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "expected_report",
        "raw_raster",
        "visual_class"
      ],
      "properties": {
        "artifact": {
          "$ref": "#/$defs/file"
        },
        "raw_raster": {
          "$ref": "#/$defs/file"
        },
        "visual_class": {
          "const": "geometry/image"
        },
        "expected_report": {
          "$ref": "#/$defs/file"
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formats",
        "id",
        "options"
      ],
      "properties": {
        "formats": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "png",
            "svg"
          ],
          "properties": {
            "png": {
              "$ref": "#/$defs/format"
            },
            "svg": {
              "$ref": "#/$defs/format"
            }
          }
        },
        "id": {
          "const": "default"
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exportBackground",
            "exportEmbedScene",
            "exportPadding",
            "exportScale",
            "exportWithDarkMode",
            "frameRendering",
            "maxWidthOrHeight",
            "viewBackgroundColor"
          ],
          "properties": {
            "exportBackground": {
              "type": "boolean"
            },
            "exportEmbedScene": {
              "type": "boolean"
            },
            "exportPadding": {
              "type": "number",
              "minimum": 0
            },
            "exportScale": {
              "type": [
                "number",
                "null"
              ]
            },
            "exportWithDarkMode": {
              "type": "boolean"
            },
            "frameRendering": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "clip",
                "enabled",
                "name",
                "outline"
              ],
              "properties": {
                "clip": {
                  "type": "boolean"
                },
                "enabled": {
                  "type": "boolean"
                },
                "name": {
                  "type": "boolean"
                },
                "outline": {
                  "type": "boolean"
                }
              }
            },
            "maxWidthOrHeight": {
              "type": [
                "number",
                "null"
              ]
            },
            "viewBackgroundColor": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
