{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sagikazarmark/excalidraw-render.orig/blob/main/tests/conformance/pdf-viewer-profile-v1.schema.json",
  "title": "excalidraw-render canonical PDF viewer profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "identity", "runtime", "implementation", "settings", "qualification"],
  "properties": {
    "schema": { "$ref": "#/$defs/schemaDescriptor" },
    "id": { "enum": ["canonical-pdf.pdfium.v1", "canonical-pdf.pdfjs.v1"] },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewer", "upstream_version", "upstream_commit", "reference_profile_digest"],
      "properties": {
        "viewer": { "enum": ["pdfium", "pdfjs"] },
        "upstream_version": { "type": "string", "minLength": 1 },
        "upstream_commit": { "type": ["string", "null"] },
        "reference_profile_digest": { "$ref": "#/$defs/prefixedSha256" }
      }
    },
    "runtime": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "value": { "type": "string", "minLength": 1 }
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lockfile", "sources", "artifacts", "features", "forbidden_features"],
      "properties": {
        "lockfile": { "$ref": "#/$defs/fileDescriptor" },
        "sources": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/fileDescriptor" } },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "url", "sha256"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "format": "uri" },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "features": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "forbidden_features": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions", "color", "rendering", "fonts", "resources", "state", "errors"],
      "properties": {
        "dimensions": { "$ref": "#/$defs/stringMap" },
        "color": { "$ref": "#/$defs/stringMap" },
        "rendering": { "$ref": "#/$defs/stringMap" },
        "fonts": { "$ref": "#/$defs/stringMap" },
        "resources": { "$ref": "#/$defs/stringMap" },
        "state": { "$ref": "#/$defs/stringMap" },
        "errors": { "$ref": "#/$defs/stringMap" }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "dpi", "restrictions"],
      "properties": {
        "case_id": { "const": "focused.rectangle-outline.v1" },
        "dpi": { "const": 96 },
        "restrictions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "prefixedSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "fileDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "schemaDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": { "const": "excalidraw-render/conformance-pdf-viewer-profile/v1" },
        "path": { "const": "tests/conformance/pdf-viewer-profile-v1.schema.json" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "stringMap": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } }
  }
}
