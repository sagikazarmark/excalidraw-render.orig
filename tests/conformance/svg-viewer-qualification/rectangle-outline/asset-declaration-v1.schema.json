{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sagikazarmark/excalidraw-render.orig/blob/main/tests/conformance/svg-viewer-qualification/rectangle-outline/asset-declaration-v1.schema.json",
  "title": "Canonical SVG viewer asset declaration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "fonts", "images"],
  "properties": {
    "schema": { "const": "excalidraw-render/svg-viewer-asset-declaration/v1" },
    "fonts": {
      "type": "array",
      "items": { "$ref": "#/$defs/font" }
    },
    "images": {
      "type": "array",
      "items": { "$ref": "#/$defs/image" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*\\/$).+$"
    },
    "style": {
      "enum": ["normal", "italic", "oblique"]
    },
    "stretch": {
      "enum": [
        "ultra-condensed",
        "extra-condensed",
        "condensed",
        "semi-condensed",
        "normal",
        "semi-expanded",
        "expanded",
        "extra-expanded",
        "ultra-expanded"
      ]
    },
    "cssFace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "style", "weight", "stretch", "unicode_range"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "style": { "$ref": "#/$defs/style" },
        "weight": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "stretch": { "$ref": "#/$defs/stretch" },
        "unicode_range": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^U\\+[0-9A-F]{1,6}(?:-[0-9A-F]{1,6}|\\?{1,5})?$"
          }
        }
      }
    },
    "fontSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_type", "sha256"],
      "properties": {
        "media_type": { "const": "font/woff2" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sfnt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "media_type",
        "sha256",
        "face_index",
        "family",
        "style",
        "weight",
        "stretch"
      ],
      "properties": {
        "path": { "$ref": "#/$defs/repositoryPath" },
        "media_type": { "enum": ["font/ttf", "font/otf"] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "face_index": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "family": { "type": "string", "minLength": 1 },
        "style": { "$ref": "#/$defs/style" },
        "weight": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "stretch": { "$ref": "#/$defs/stretch" }
      }
    },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "css", "sfnt"],
      "properties": {
        "source": { "$ref": "#/$defs/fontSource" },
        "css": { "$ref": "#/$defs/cssFace" },
        "sfnt": { "$ref": "#/$defs/sfnt" }
      }
    },
    "imageSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_type", "sha256"],
      "properties": {
        "media_type": {
          "enum": [
            "image/png",
            "image/apng",
            "image/jpeg",
            "image/jfif",
            "image/gif",
            "image/webp",
            "image/bmp",
            "image/x-icon",
            "image/avif",
            "image/svg+xml"
          ]
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "canonicalImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "media_type", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/repositoryPath" },
        "media_type": { "enum": ["image/png", "image/svg+xml"] },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "canonical"],
      "properties": {
        "source": { "$ref": "#/$defs/imageSource" },
        "canonical": { "$ref": "#/$defs/canonicalImage" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "properties": { "media_type": { "const": "image/svg+xml" } }
              }
            }
          },
          "then": {
            "properties": {
              "canonical": {
                "properties": { "media_type": { "const": "image/svg+xml" } }
              }
            }
          },
          "else": {
            "properties": {
              "canonical": {
                "properties": { "media_type": { "const": "image/png" } }
              }
            }
          }
        }
      ]
    }
  }
}
