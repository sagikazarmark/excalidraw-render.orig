"""
Continuous integration for the excalidraw-render workspace.

The GitHub workflows remain the source of truth for the platform matrix
(macOS, Windows, and the Chromium WASM leg); everything they run on Linux is
mirrored here so the same gates are reproducible on a laptop.
"""
type ExcalidrawRender {
  let rust: Rust!

  new(
    ws: Workspace!,
    """
    Version (image tag) to use from the official Rust image repository as a base container.
    """
    rustVersion: String! = "latest",
  ) {
    self.rust = Dagger.rust(ws: ws, version: rustVersion)

    self
  }

  """
  Formatting and lint gates.
  """
  lint: Lint! {
    Lint(self.rust.container)
  }

  """
  Verification of the sealed catalog and the approval-bearing evidence manifests.
  """
  conformance: Conformance! {
    Conformance(self.rust.container)
  }

  """
  Unit, integration, and documentation test targets.
  """
  test: Test! {
    Test(self.rust.container)
  }

  """
  The packaged crates and the public facade a downstream consumer compiles against.
  """
  packaging: Packaging! {
    Packaging(self.rust.container, hostTarget)
  }

  """
  Randomized expansions that the nightly schedule runs, not the push gates.
  """
  nightly: Nightly! {
    Nightly(self.rust.container)
  }
}

"""
Rust target triple matching the engine's default platform.

The packaging gates pass an explicit `--target`, the way the workflow matrix
does, so the triple has to follow the platform the checks land on.
"""
let hostTarget: String! {
  Dagger
    .defaultPlatform
    .{
      case (_) {
        "linux/amd64" => "x86_64-unknown-linux-gnu"
        "linux/arm64" => "aarch64-unknown-linux-gnu"
        else => raise "unsupported platform: " + toString(_)
      }
    }
}

"""
Formatting and lint gates from the `conformance` workflow's `lint` job.
"""
type Lint {
  let container: Container!

  new(
    """
    Container with the Rust toolchain and the project source.
    """
    container: Container!,
  ) {
    self.container = container

    self
  }

  """
  Check the formatting of every repo-authored crate.

  The vendored skera fork keeps upstream formatting. xtask joined
  when the #133/#150 PDF round re-pinned xtask/src/pdf_viewers.rs (issue #35).
  """
  fmt: String! @check {
    self.run([
      "cargo", "fmt", "--check",
      "--package", "excalidraw-render",
      "--package", "excalidraw-render-cli",
      "--package", "excalidraw-render-compare",
      "--package", "excalidraw-render-assets-base",
      "--package", "excalidraw-render-assets-data-000",
      "--package", "excalidraw-render-assets-data-001",
      "--package", "xtask",
    ])
  }

  """
  Lint the renderer, the CLI, and xtask.

  `--no-deps` keeps the vendored skera fork out of the gate: it is a workspace
  member, so `--exclude` alone would still lint it as a dependency of the
  selected packages. No lint is allowed: the `manual_is_multiple_of` and
  `chunks_exact_to_as_chunks` occurrences that sat in the #99-pinned files
  were fixed in the font approval round that re-pinned them (#141).
  """
  clippy: String! @check {
    self.run([
      "cargo", "clippy", "--locked", "--no-deps", "--all-targets",
      "--package", "excalidraw-render",
      "--package", "excalidraw-render-cli",
      "--package", "xtask",
      "--", "-D", "warnings",
    ])
  }

  let run(args: [String!]!): String! {
    self.container.withExec(args).combinedOutput
  }
}

"""
Catalog and evidence verification driven by xtask.

These are the gates that keep the approval records honest: every one of them
re-derives a digest from the working tree and compares it against a manifest
that carries a human approval, so a silent edit to a pinned file fails here
before it reaches the qualification workflows.
"""
type Conformance {
  let container: Container!

  new(
    """
    Container with the Rust toolchain and the project source.
    """
    container: Container!,
  ) {
    self.container = container

    self
  }

  """
  Verify every registered conformance case.
  """
  registeredCases: String! @check {
    self.xtask(["conformance", "verify-all"])
  }

  """
  Verify the sealed revision catalog.
  """
  catalog: String! @check {
    self.xtask(["catalog", "verify"])
  }

  """
  Verify the approved SVG font subset release evidence.
  """
  svgFontSubsetRelease: String! @check {
    self.xtask(["conformance", "verify-svg-font-subset-release"])
  }

  """
  Verify the approved SVG font subset qualification (issue #99).
  """
  svgFontSubsets: String! @check {
    self.xtask(["conformance", "verify-svg-font-subsets"])
  }

  """
  Verify the approved SVG viewer qualification (issue #34).
  """
  svgViewers: String! @check {
    self.xtask(["conformance", "verify-svg-viewers"])
  }

  """
  Verify the approved PDF viewer qualification (issue #35).
  """
  pdfViewers: String! @check {
    self.xtask(["conformance", "verify-pdf-viewers"])
  }

  let xtask(args: [String!]!): String! {
    self
      .built
      .withExec(["cargo", "run", "--locked", "--package", "xtask", "--"] + args)
      .combinedOutput
  }

  """
  Container with xtask already compiled.

  Every check below runs the same binary, so compiling it once keeps the six
  of them sharing one cached layer instead of rebuilding it six times.
  """
  let built: Container! {
    self.container.withExec(["cargo", "build", "--locked", "--package", "xtask"])
  }
}

"""
Test targets from the `conformance` workflow.

The push gate is the `ci-fast` and `ci-render` profiles of `.config/nextest.toml`,
which together cover the `default` profile exactly once. Each profile selects
its tier by binary name and kind: the renderer's `fast` binary and every other
crate's targets are the fast tier, the `parity_*` and `limits_*` binaries the
render tier, and the `harness_*` binaries, which need the pinned viewer
harnesses, belong to neither. Both checks execute from one compiled layer, so a
failure is legible in its tier at the price of a second execution rather than a
second compile. nextest runs no doc tests, so `doc` runs them through cargo.

The test profile in the root Cargo.toml is optimized, and the two corpus-driven
tests the push gate does not carry are held back the way the workflow holds
them: the frame batch property test and the SVG font subset qualification
corpus are both `#[ignore]`d unless the `release-qualification` feature is on
(off here). `packaging:qualification` runs both in `--release`.
"""
type Test {
  let container: Container!

  new(
    """
    Container with the Rust toolchain and the project source.
    """
    container: Container!,
  ) {
    self.container = container

    self
  }

  """
  Execute the fast tier: every test outside the parity, limits and harness binaries.
  """
  fast: String! @check {
    self.nextest(["--profile", "ci-fast"])
  }

  """
  Execute the render tier: the parity harnesses and the fixed parser ceilings.
  """
  render: String! @check {
    self.nextest(["--profile", "ci-render"])
  }

  """
  Execute every documentation test in the workspace.
  """
  doc: String! @check {
    self
      .compiled
      .withExec(["cargo", "test", "--locked", "--workspace", "--doc"])
      .combinedOutput
  }

  let nextest(args: [String!]!): String! {
    self
      .compiled
      .withExec(["cargo", "nextest", "run", "--locked", "--workspace"] + args)
      .combinedOutput
  }

  """
  Container with cargo-nextest installed and every workspace test target compiled.

  The checks above are disjoint selections of the same targets, so they build
  once into a shared cached layer and then only execute.
  """
  let compiled: Container! {
    self
      .container
      .withFile("/usr/local/bin/cargo-nextest", cargoNextestBinary(self.container))
      .withExec(["cargo", "nextest", "run", "--locked", "--workspace", "--no-run"])
  }
}

"""
The pinned cargo-nextest release for the engine's platform: the version and
archive digest `tests/package-consumer/tool-manifest.json` records for the
workflows, verified by the engine when the archive is fetched and unpacked in
the given container.
"""
let cargoNextestBinary(container: Container!): File! {
  let target = hostTarget
  let checksum = target.{
    case (_) {
      "x86_64-unknown-linux-gnu" => "sha256:66786b9abe23920d022a182d1416b1bbc8130dd4872a9553d76985a1708dcd1e"
      "aarch64-unknown-linux-gnu" => "sha256:2a64b3566a92508550a7ab29c3e8db25472ca37730ecb4d22100b6aa440c2a68"
      else => raise "cargo-nextest is not pinned for " + _
    }
  }
  let archive = `cargo-nextest-0.9.143-${target}.tar.gz`

  container
    .withMountedFile("/tmp/" + archive, Dagger.http(
      url: "https://github.com/nextest-rs/nextest/releases/download/cargo-nextest-0.9.143/" + archive,
      name: archive,
      checksum: checksum,
    ))
    .withExec(["tar", "-xzf", "/tmp/" + archive, "-C", "/tmp", "cargo-nextest"])
    .file("/tmp/cargo-nextest")
}

"""
The Linux leg of the `Packaged public facade` workflow.

The workflow runs this across a four-target matrix; only the Linux entry is
reproducible here, so the macOS and Windows legs stay on GitHub Actions.
"""
type Packaging {
  let container: Container!
  let target: String!

  new(
    """
    Container with the Rust toolchain and the project source.
    """
    container: Container!,
    """
    Rust target triple to package and compile for.
    """
    target: String!,
  ) {
    self.container = container
    self.target = target

    self
  }

  """
  Execute the release-mode qualification set.

  The complete renderer unit target in `--release` with the
  `release-qualification` feature, the way the workflow's native leg runs it
  before materializing target evidence: the SVG font subset qualification
  corpus and the frame batch property test, which the `test` checks leave out,
  execute here. No name filter, so a renamed test cannot drop out of the run.
  """
  qualification: String! @check {
    self
      .container
      .withExec([
        "cargo", "test", "--locked", "--release",
        "--target", self.target,
        "--package", "excalidraw-render",
        "--features", "release-qualification",
        "--lib",
      ])
      .combinedOutput
  }

  """
  Check the packaged CLI against the packaged renderer.
  """
  cli: String! @check {
    self
      .packaged
      .withExec(["bash", "tests/package-consumer/check-packaged-cli.sh", self.target])
      .combinedOutput
  }

  """
  Execute the packaged public facade against the packaged renderer.
  """
  publicFacade: String! @check {
    self
      .packaged
      .withWorkdir("tests/package-consumer")
      .withExec([
        "cargo", "test", "--locked", "--release",
        "--target", self.target,
        "--test", "public_facade",
      ])
      .combinedOutput
  }

  """
  Container carrying the packaged crate archives, unpacked under target/package.

  The consumer crate resolves `excalidraw-render` through a path dependency on
  the unpacked archive, so the facade compiles against what `cargo package`
  would publish rather than against the working tree.

  The workflow lets Cargo default to `<repository>/target`, while the Rust
  module points CARGO_TARGET_DIR at a directory outside the source tree. The
  checked-in consumer manifest and scripts address the archives through the
  repository-relative path, so link it back onto whatever Cargo is using.
  """
  let packaged: Container! {
    self
      .container
      .withExec([
        "sh", "-c",
        "if [ -n \"$CARGO_TARGET_DIR\" ] && [ \"$CARGO_TARGET_DIR\" != \"$PWD/target\" ]; then ln -sfn \"$CARGO_TARGET_DIR\" target; fi",
      ])
      .withExec([
        "cargo", "package", "--locked", "--workspace",
        "--exclude", "xtask",
        "--exclude", "excalidraw-render-compare",
        "--no-verify",
      ])
      .withExec([
        "sh", "-c",
        "for archive in target/package/*.crate; do tar -xzf \"$archive\" -C target/package; done",
      ])
  }
}

"""
The randomized expansions the nightly schedule runs.

These are deliberately not checks: they are bounded but long, and the push
gates should not carry them. Run one with
`dagger call nightly font-subset-fuzz`.
"""
type Nightly {
  let container: Container!

  new(
    """
    Container with the Rust toolchain and the project source.
    """
    container: Container!,
  ) {
    self.container = container

    self
  }

  """
  Execute the bounded font subset fuzz expansion.
  """
  fontSubsetFuzz(
    """
    Number of cases to expand.
    """
    cases: String! = "4096",
  ): String! {
    self
      .container
      .withEnvVariable("EXCALIDRAW_FONT_SUBSET_FUZZ_CASES", cases)
      .withExec([
        "cargo", "test", "--locked", "--release",
        "--package", "excalidraw-render", "--lib",
        "render::font_subset_fuzz::nightly_font_subset_fuzz_is_bounded_and_deterministic",
        "--", "--ignored", "--exact",
      ])
      .combinedOutput
  }

  """
  Execute the deeper batch-versus-standalone frame expansion.
  """
  frameBatchProperty(
    """
    Number of cases to expand.
    """
    cases: String! = "512",
  ): String! {
    self
      .container
      .withEnvVariable("EXCALIDRAW_FRAME_BATCH_CASES", cases)
      .withExec([
        "cargo", "test", "--locked", "--release",
        "--package", "excalidraw-render", "--lib",
        "render::frame_batch_property::nightly_frame_batch_property_runs_a_deeper_sample",
        "--", "--ignored", "--exact",
      ])
      .combinedOutput
  }

  """
  Execute the bounded scene admission and normalization fuzz expansion.
  """
  sceneFuzz(
    """
    Number of cases to expand.
    """
    cases: String! = "4096",
  ): String! {
    self
      .container
      .withEnvVariable("EXCALIDRAW_SCENE_FUZZ_CASES", cases)
      .withExec([
        "cargo", "test", "--locked", "--release",
        "--package", "excalidraw-render", "--lib",
        "scene_fuzz::nightly_scene_fuzz_is_bounded_and_deterministic",
        "--", "--ignored", "--exact",
      ])
      .combinedOutput
  }
}
