"""
CI inputs and immutable compilation layers. Code/compile-time fixtures are
separate from runtime evidence and Git history. Cargo target output lives outside
the source mount, so cooking dependencies and replacing input views cannot hide it.
"""
type Builds {
  let workspace: Workspace!
  let base: Container!
  let version: String!

  new(ws: Workspace!, version: String!) {
    self.workspace = ws
    self.version = version
    self.base = Dagger.container(platform: "linux/amd64").from("rust:" + version)
      .withExec(["bash", "-eu", "-c", "apt-get update && apt-get install -y --no-install-recommends git python3 nodejs unzip"])
      .withEnvVariable("CARGO_BUILD_JOBS", "2")
      .withEnvVariable("CARGO_INCREMENTAL", "0")
      .withEnvVariable("CARGO_TARGET_DIR", "/target")
    self
  }

  let source: Directory! {
    self.workspace.directory("/", gitignore: true)
      .withFile("dagger.lock", self.workspace.file("dagger.lock"))
  }

  """
  Export the input views for inspection. Full history/evidence is a runtime input,
  not an input to formatting, dependency cooking, or Rust compilation.
  """
  inputs(kind: String!): Directory! {
    case (kind) {
      "format" => self.formatSource
      "code" => self.codeSource
      "compile" => self.compileSource
      "runtime" => self.source
      else => raise "input kind must be format, code, compile or runtime"
    }
  }

  """
  Prevent broad source imports from silently returning to the cheap build views.
  Real Cargo builds validate that the compile view also contains every include.
  """
  verifyInputs: String! {
    if (self.formatSource.exists(".git") or self.formatSource.exists("tests")
      or !self.formatSource.glob("**/*.bin").isEmpty) {
      raise "format input unexpectedly contains history, evidence or asset blobs"
    }
    if (self.compileSource.exists(".git")
      or self.compileSource.exists("tests/conformance/coverage/ownership.json")
      or self.compileSource.exists("tests/conformance/proposals")) {
      raise "compile input unexpectedly contains runtime history or ledger archives"
    }
    if (!self.source.exists(".git")
      or !self.source.exists("tests/conformance/coverage/ownership.json")
      or !self.compileSource.exists("crates/excalidraw-render-assets-data-000/data/revision-1-000.bin")
      or !self.formatSource.exists("xtask/src/main.rs")) {
      raise "required source input is missing"
    }
    "format/compile input boundaries verified; runtime evidence and Git retained"
  }

  let codeSource: Directory! {
    self.workspace.directory("/", include: codeInputs, gitignore: true)
  }

  let formatSource: Directory! {
    self.workspace.directory("/", gitignore: true, include: [
      "crates/**/*.rs", "crates/**/Cargo.toml", "xtask/**/*.rs", "xtask/Cargo.toml",
      "Cargo.toml", "Cargo.lock", "README.md", "LICENSE-*",
      ".cargo/**", ".config/**", "rust-toolchain*", "clippy.toml",
    ])
  }

  let compileSource: Directory! {
    self.workspace.directory("/", include: codeInputs + compileFixtures, gitignore: true)
  }

  format: Container! {
    Dagger.rust(ws: self.formatSource.asWorkspace, version: self.version,
      container: self.base, noCache: true).container
  }

  """
  A general-purpose full checkout for explicit generation/release operations.
  No compiled test target is a prerequisite of an ad-hoc evidence command.
  """
  full: Container! {
    Dagger.rust(ws: self.source.asWorkspace, version: self.version,
      container: self.base, noCache: true).container
      .withExec(["cargo", "fetch", "--locked"])
  }

  let testDependencies: Container! {
    self.cook(self.compileSource, self.base, ["--workspace", "--all-targets", "--profile", "test"])
  }

  let cliDependencies: Container! {
    self.cook(self.codeSource, self.base, ["--release", "-p", "excalidraw-render-cli"])
  }

  let nativeReleaseDependencies: Container! {
    self.cook(self.compileSource, self.base,
      ["--release", "--tests", "-p", "excalidraw-render", "--target", hostTarget])
  }

  let cook(source: Directory!, base: Container!, args: [String!]!): Container! {
    Dagger.rust(ws: source.asWorkspace, version: self.version, container: base,
      noCache: true, chef: true, chefVersion: "0.1.78", chefArgs: args)
      .withEnvVariable("CARGO_BUILD_JOBS", "2")
      .container
  }

  """
  One native workspace compilation, plus the exact release CLI that evidence
  tests invoke. Profile-specific dependency cooks can run together; consumers
  wait for these shared builds instead of each launching a separate compilation.
  """
  nativeTests: Container! {
    self.testDependencies
      .withFile("/usr/local/bin/cargo-nextest", cargoNextestBinary(self.base))
      .withExec(["cargo", "nextest", "run", "--locked", "--workspace", "--no-run"])
  }

  nativeSlim: Container! {
    self.nativeTests
      .withDirectory("/target/release", self.cliDependencies.directory("/target/release"))
      .withDirectory("/target/" + hostTarget + "/release",
        self.nativeReleaseDependencies.directory("/target/" + hostTarget + "/release"))
      .withExec(["/target/debug/xtask", "conformance", "build-native-cli"])
  }

  """
  Inspect one compilation phase directly, without starting the full check graph.
  Returns the actual compiler output; these commands do not execute test suites.
  """
  build(phase: String!): String! {
    let container = case (phase) {
      "input-cache" => self.base.withDirectory("/work/src", self.compileSource)
        .withWorkdir("/work/src").withExec(["sha256sum", "Cargo.toml", "Cargo.lock"])
      "native-dependencies" => self.testDependencies
      "native-tests" => self.nativeTests
      "native-cli" => self.nativeSlim
      "native-release-tests" => self.nativeReleaseBuilt
      "native-traces" => self.nativeTraceBuilt
      "wasm-release-tests" => self.wasmReleaseBuilt
      "wasm-traces" => self.wasmTraceBuilt
      else => raise "unknown compilation phase"
    }
    container.combinedOutput
  }

  native: Container! {
    withQpdf(self.runtime(self.nativeReleaseBuilt))
  }

  let nativeReleaseBuilt: Container! {
    self.nativeSlim.withExec(["cargo", "test", "--locked", "--release",
      "--target", hostTarget, "-p", "excalidraw-render", "--lib",
      "--features", "release-qualification", "--no-run"])
  }

  let nativeTraceBuilt: Container! {
    self.compileTraces(self.native, hostTarget)
  }

  let browserTools: Container! {
    browserContainer(self.base
      .withDirectory("/work/src", self.source.filter(include: [
        "tests/package-consumer/*.sh", "tests/package-consumer/tool-manifest.json",
        "tests/package-consumer/*.xml", "tests/package-consumer/webdriver.json",
        "tools/ci/install-browser.sh",
      ]))
      .withWorkdir("/work/src"))
      .withoutDirectory("/work/src")
  }

  let wasmDependencies: Container! {
    self.cook(self.compileSource, self.browserTools,
      ["--release", "--tests", "-p", "excalidraw-render", "--target", "wasm32-unknown-unknown"])
  }

  wasm: Container! {
    self.runtime(self.wasmReleaseBuilt)
  }

  let wasmReleaseBuilt: Container! {
    # Resolve the host tool from the completed native trace build: expensive
    # real compilation progresses in phases rather than fanning out per check.
    self.wasmDependencies
      .withFile("/target/debug/xtask", self.nativeTraceBuilt.file("/target/debug/xtask"))
      .withExec(["cargo", "test", "--locked", "--release", "--target",
        "wasm32-unknown-unknown", "-p", "excalidraw-render", "--lib", "--no-run"])
  }

  let wasmTraceBuilt: Container! {
    self.compileTraces(self.wasm, "wasm32-unknown-unknown")
  }

  let compileTraces(container: Container!, target: String!): Container! {
    let staged = container.withExec(["/target/debug/xtask", "conformance", "stage-traces"])
    let source = staged.directory("/work/src")
    staged.withoutDirectory("/work/src")
      .withDirectory("/work/src", source.filter(include: codeInputs + compileFixtures))
      .withWorkdir("/work/src")
      .withExec(["cargo", "test", "--locked", "--release", "--target", target,
        "-p", "excalidraw-render", "--lib", "--no-run"])
      .withDirectory("/work/src", source)
  }

  traceContainer(target: String!): Container! {
    if (target == hostTarget) { return self.nativeTraceBuilt }
    if (target == "wasm32-unknown-unknown") { return self.wasmTraceBuilt }
    raise "unqualified trace target"
  }

  consumerContainer(target: String!): Container! {
    let container = if (target == hostTarget) { self.native } else { self.wasm }
    # Each target's consumers wait for its release/trace compiler phase. Native
    # checks remain native-only; native consumers can overlap the WASM phase.
    container.withFile("/target/debug/xtask", self.traceContainer(target).file("/target/debug/xtask"))
  }

  compileConsumer(container: Container!, target: String!): Container! {
    let source = container.directory("/work/src")
    let slim = container.withoutDirectory("/work/src")
      .withDirectory("/work/src", source.filter(include: [
        "target/package/**", "tests/package-consumer/**", ".cargo/**", "rust-toolchain*",
        "tests/conformance/cases/focused/rectangle-outline/scene.excalidraw",
        "tests/conformance/cases/focused/rectangle-outline/expected-report-svg.json",
        "tests/conformance/cases/focused/excalifont-text/scene.excalidraw",
      ]))
      .withWorkdir("/work/src/tests/package-consumer")
    let compiled = if (target == hostTarget) {
      slim.withExec(["cargo", "test", "--locked", "--release", "--target", target,
        "--no-run", "--test", "public_facade", "--example", "native_snapshots"])
        .withExec(["cargo", "build", "--locked", "--release", "--target", target,
          "--example", "native_snapshots"])
    } else {
      slim.withExec(["cargo", "test", "--locked", "--release", "--target", target,
        "--no-run", "--test", "public_facade", "--test", "generated_snapshots"])
    }
    compiled.withDirectory("/work/src", source).withWorkdir("/work/src")
  }

  let runtime(container: Container!): Container! {
    container.withoutMount("/work/src")
      .withDirectory("/work/src", self.source)
      .withWorkdir("/work/src")
  }

  """
  Platform-independent package archives are prepared once for native and WASM.
  Keep their real paths inside the checkout for the collector's path boundary;
  compilation output remains in /target.
  """
  packages: Directory! {
    self.native
      .withExec(["cargo", "package", "--locked", "--workspace", "--exclude", "xtask",
        "--exclude", "excalidraw-render-compare", "--allow-dirty", "--no-verify",
        "--target-dir", "/work/src/target"])
      .withExec(["bash", "-eu", "-c", "for archive in target/package/*.crate; do tar -xzf \"$archive\" -C target/package; done"])
      .directory("/work/src/target/package")
  }
}

let codeInputs: [String!]! = [
  "Cargo.toml", "Cargo.lock", "README.md", "LICENSE-*", "clippy.toml",
  ".cargo/**", ".config/**", "rust-toolchain*", "crates/**", "xtask/**",
]

"""
Compile-time include_bytes!/include_str! inputs, cross-checked by real builds.
Runtime fs::read inputs are attached only after compilation. The explicit
patterns intentionally omit historical coverage/proposal bundles and Git.
"""
let compileFixtures: [String!]! = [
  "tests/oracle/*/reference.json", "tests/oracle/*/inputs.json",
  "tests/oracle/*/*-reference.json", "tests/oracle/*/*-measurements.json",
  "tests/oracle/*/*-exceptions.json", "tests/oracle/scene-surfaces/revision-1.json",
  "tests/conformance/coverage/png-profiles.json",
  "tests/conformance/pdf-backend-qualification/*.json",
  "tests/conformance/pdf-backend-qualification/*.excalidraw",
  "tests/conformance/cases/focused/bound-text-containers/scene.excalidraw",
]
