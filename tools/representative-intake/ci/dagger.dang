"""
Run the representative-intake real-renderer tests in a sealed container (optional; not a gate, ADR-0024).
"""
type RepresentativeIntake {
  let container: Container!

  new(ws: Workspace!) {
    self.container = Dagger
      .rust(
        ws: ws,
        version: "1.97.1-slim-trixie",
        container: Dagger
          .container(platform: "linux/amd64")
          .from("rust:1.97.1-slim-trixie")
          .withExec(["bash", "-eu", "-c", "apt-get update && apt-get install -y --no-install-recommends git"]),
      )
      .withEnvVariable("CARGO_BUILD_JOBS", "2")
      .withEnvVariable("CARGO_TARGET_DIR", "/work/src/target")
      .withEnvVariable("CARGO_PROFILE_DEV_DEBUG", "0")
      .withEnvVariable("CARGO_PROFILE_TEST_DEBUG", "0")
      .container
    self
  }

  """
  Run command-boundary tests with a real renderer and validate retained intake.
  """
  verify: String! @check {
    self
      .container
      .withExec(["cargo", "build", "--locked", "-p", "excalidraw-render-cli", "-p", "xtask"])
      .withEnvVariable("REPRESENTATIVE_RENDERER", "/work/src/target/debug/excalidraw-render")
      .withExec(["cargo", "test", "--locked", "-p", "xtask", "--test", "representative_intake", "--test", "representative_case", "--", "--include-ignored"])
      .withExec(["cargo", "test", "--locked", "-p", "xtask", "--test", "representative_numeric", "--test", "representative_judge", "--test", "representative_viewer_assets", "--test", "representative_retention", "--test", "representative_evidence"])
      .withExec(["/work/src/target/debug/xtask", "representative", "verify", "tests/conformance/intake/velox-design-v1"])
      .withExec(["/work/src/target/debug/xtask", "representative", "capture", "tests/conformance/intake/velox-design-v1", "/work/src/target/debug/excalidraw-render", "/tmp/velox-intake-capture"])
      .withExec(["/work/src/target/debug/xtask", "representative", "verify-capture", "tests/conformance/intake/velox-design-v1", "/tmp/velox-intake-capture"])
      .withExec(["/work/src/target/debug/xtask", "representative", "case", "verify-registry", "--renderer", "/work/src/target/debug/excalidraw-render"])
      .combinedOutput
  }
}
