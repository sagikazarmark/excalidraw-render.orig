"""
The package-consumer browser is distinct from the reference/viewer Chromium.
Its archive hashes, driver and wasm runner come from tool-manifest.json.
"""
let browserContainer(container: Container!): Container! {
  container
    .withExec(["bash", "-eu", "-c", "apt-get update && apt-get install -y --no-install-recommends jq curl unzip clang lld pkg-config libssl-dev libnss3 libatk-bridge2.0-0 libx11-xcb1 libxcomposite1 libxdamage1 libxrandr2 libxfixes3 libxkbcommon0 libgbm1 libasound2t64 libcups2 libpango-1.0-0 libcairo2"])
    .withExec(["bash", "tools/ci/install-browser.sh"])
    .withEnvVariable("CHROMEDRIVER", "/usr/local/bin/chromedriver")
    .withEnvVariable("CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER", "wasm-bindgen-test-runner")
    .withEnvVariable("CC_wasm32_unknown_unknown", "clang")
    .withEnvVariable("FONTCONFIG_FILE", "/work/src/tests/package-consumer/fontconfig.xml")
    .withEnvVariable("WASM_BINDGEN_TEST_TIMEOUT", "1800")
    .withEnvVariable("WASM_BINDGEN_TEST_WEBDRIVER_JSON", "/work/src/tests/package-consumer/webdriver.json")
}

"""
Explicit operations on evidence. Outputs are exported for review; these are
not automatic generators because several intentionally invalidate approvals.
"""
type Evidence {
  let container: Container!

  new(container: Container!) {
    self.container = container
    self
  }

  """
  Run an xtask operation and export the resulting source tree (without build output).
  Example: --args catalog,materialize. Approval commands retain xtask's validation.
  """
  xtask(args: [String!]!): Directory! {
    self.container
      .withExec(["cargo", "run", "--locked", "-p", "xtask", "--"] + args)
      .directory("/work/src")
      .filter(exclude: [".git", "target", "**/node_modules"])
  }

  """
  Stage the shared draft coverage inventory for review (#85 / #86).
  """
  inventory: File! {
    self.container
      .withExec([
        "cargo", "run", "--locked", "-p", "xtask", "--", "conformance", "inventory",
      ], redirectStdout: "/inventory.json")
      .file("/inventory.json")
  }

  """
  Regenerate the per-cell font subset corpus in the pinned native toolchain.
  """
  fontCorpus: Directory! {
    self.container
      .withExec([
        "cargo", "test", "--locked", "--release", "-p", "excalidraw-render", "--lib",
        "render::font_subset_qualification::materialize_complete_font_subset_qualification_corpus",
        "--", "--ignored", "--exact",
      ])
      .withExec(["bash", "-eu", "-c", "mkdir /corpus; cp /target/tmp/svg-font-subset-qualification-corpus-*/* /corpus/"])
      .directory("/corpus")
  }

  """
  Execute the ignored PDF harness gates with exact-pinned Python, PDFium, PDF.js and qpdf.
  """
  pdf: String! {
    self.run([
      "bash", "-eu", "-c",
      "bash tools/pdf-harness/install.sh && cargo nextest run --locked --release -p excalidraw-render --profile harness --run-ignored only -E 'binary(/^harness_pdf_/)'",
    ]).combinedOutput
  }

  """
  Reproduce or generate font-subset, SVG, or PDF viewer evidence.
  Existing scripts enforce their overwrite and approval rules.
  """
  viewers(kind: String!, mode: String! = "reproduce"): Directory! {
    if (mode != "reproduce" and mode != "generate") {
      raise "mode must be reproduce or generate"
    }
    let script = kind.{ case (_) {
      "font-subset" => "tools/svg-font-subset-qualification.sh"
      "svg" => "tools/svg-viewer-qualification.sh"
      "pdf" => "tools/pdf-viewer-qualification.sh"
      else => raise "kind must be font-subset, svg or pdf"
    } }
    let prepare = "bash tools/reference-oracle/run-container.sh install && cargo fetch --locked --manifest-path tools/svg-viewer-rust/Cargo.toml"
    if (kind == "pdf") { prepare = "bash tools/pdf-harness/install.sh" }
    self.run([
      "bash", "-eu", "-c",
      prepare + " && bash \"$1\" \"$2\"",
      "viewers", script, mode,
    ]).directory("/work/src").filter(exclude: [".git", "**/node_modules", "target/**/release", "target/pdf-harness"])
  }

  """
  Verify or update the scene or frame reference profile in its pinned container.
  """
  reference(mode: String! = "verify", frame: Boolean! = false): Directory! {
    if (mode != "verify" and mode != "update") {
      raise "mode must be verify or update"
    }
    let script = "tools/reference-oracle/run-container.sh"
    if (frame) { script = "tools/reference-oracle/run-frame-profile.sh" }
    self.run([
      "bash", "-eu", "-c",
      "bash tools/reference-oracle/run-container.sh install && bash \"$1\" \"$2\"",
      "reference", script, mode,
    ]).directory("/work/src").filter(exclude: [".git", "target", "**/node_modules"])
  }

  """
  Generate or reproduce a registered conformance case using its selected reference runner.
  """
  case(caseId: String!, mode: String! = "reproduce"): Directory! {
    if (mode != "reproduce" and mode != "generate") {
      raise "mode must be reproduce or generate"
    }
    let result = self.run([
      "bash", "-eu", "-c",
      "bash tools/reference-oracle/run-container.sh install && cargo run --locked -p xtask -- conformance \"$1\" \"$2\"",
      "case", mode, caseId,
    ])
    if (mode == "reproduce") {
      return result.directory("/work/src/target/reference-evidence")
    }
    result.directory("/work/src").filter(exclude: [".git", "target", "**/node_modules"])
  }

  """
  Keep approval-pinned Docker runners verbatim. A private nested daemon gives
  them their original image, bind-mount and network-none semantics under Dagger.
  No host Docker socket or host-installed language tools are used.
  """
  let run(args: [String!]!): Container! {
    self.harness.withExec(["bash", "tools/ci/with-docker.sh"] + args, insecureRootCapabilities: true)
  }

  let harness: Container! {
    Dagger.container(platform: "linux/amd64")
      .from("mcr.microsoft.com/playwright@sha256:111dde95859f2c659291cb60e698f9048a8fc30b35b4ddb7c90f9cb5b73062d9")
      .withExec(["bash", "-eu", "-c", "sed -i 's|http://archive.ubuntu.com/ubuntu|https://mirrors.edge.kernel.org/ubuntu|g; s|http://security.ubuntu.com/ubuntu|https://security.ubuntu.com/ubuntu|g' /etc/apt/sources.list.d/ubuntu.sources && apt-get -o APT::Update::Error-Mode=any update && apt-get install -y --no-install-recommends docker.io curl unzip jq build-essential pkg-config libssl-dev"])
      .withDirectory("/usr/local/rustup", self.container.directory("/usr/local/rustup"))
      .withDirectory("/usr/local/cargo/bin", self.container.directory("/usr/local/cargo/bin"))
      .withEnvVariable("RUSTUP_HOME", "/usr/local/rustup")
      .withEnvVariable("CARGO_HOME", "/root/.cargo")
      .withEnvVariable("CARGO_TARGET_DIR", "/work/src/target")
      .withEnvVariable("CARGO_BUILD_JOBS", "2")
      .withEnvVariable("PATH", "/usr/local/cargo/bin:$PATH", expand: true)
      .withFile("/usr/local/bin/cargo-nextest", cargoNextestBinary(self.container))
      .withDirectory("/work/src", self.container.directory("/work/src"))
      .withWorkdir("/work/src")
      .withExec(["cargo", "fetch", "--locked"])
  }
}
